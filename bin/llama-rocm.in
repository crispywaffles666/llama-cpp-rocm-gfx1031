#!/usr/bin/env bash
set -euo pipefail

readonly RELEASE_VERSION='@@RELEASE_VERSION@@'
readonly DEFAULT_IMAGE='@@IMAGE_REF@@'
readonly PODMAN="${LLAMA_ROCM_PODMAN:-podman}"

usage() {
    cat <<'EOF'
Usage: llama-rocm <command> [llama.cpp arguments...]

Commands:
  server    Run llama-server on http://127.0.0.1:8080 by default
  cli       Run llama-cli
  bench     Run llama-bench
  rocminfo  Show the ROCm agents visible inside the container
  version   Show launcher, image, llama.cpp, and ROCm versions
  help      Show this help

Configuration:
  LLAMA_MODELS_DIR          Host model directory (default: ~/.local/share/llama/models)
  HF_HOME                   Persistent Hugging Face cache (default: ~/.cache/huggingface)
  LLAMA_ROCM_IMAGE          Override the digest-pinned release image
  LLAMA_ROCM_PORT           Host port for server (default: 8080)
  LLAMA_ROCM_BIND_ADDRESS   Published server address (default: 127.0.0.1)
EOF
}

die() {
    printf 'llama-rocm: %s\n' "$*" >&2
    exit 1
}

command_name="${1:-help}"
if [[ $# -gt 0 ]]; then
    shift
fi

case "${command_name}" in
    help|-h|--help)
        usage
        exit 0
        ;;
    server|cli|bench|rocminfo|version)
        ;;
    *)
        usage >&2
        die "unknown command: ${command_name}"
        ;;
esac

command -v "${PODMAN}" >/dev/null 2>&1 || die "Podman was not found: ${PODMAN}"

image="${LLAMA_ROCM_IMAGE:-${DEFAULT_IMAGE}}"
# Keep the source-tree launcher convenient without placing the complete image
# placeholder anywhere except DEFAULT_IMAGE. The release renderer replaces all
# complete placeholders, so repeating it in this check would also rewrite the
# sentinel and make a digest-pinned launcher fall back to the mutable edge tag.
if [[ "${image}" == '@@IMAGE_'* ]]; then
    image='ghcr.io/crispywaffles666/llama-cpp-rocm-gfx1031:edge'
fi

models_dir="${LLAMA_MODELS_DIR:-${HOME}/.local/share/llama/models}"
hf_home="${HF_HOME:-${HOME}/.cache/huggingface}"
mkdir -p "${models_dir}" "${hf_home}/hub"
models_dir="$(realpath "${models_dir}")"
hf_home="$(realpath "${hf_home}")"

needs_gpu=1
if [[ "${command_name}" == version ]]; then
    needs_gpu=0
fi

if [[ ${needs_gpu} -eq 1 && "${LLAMA_ROCM_SKIP_DEVICE_CHECK:-0}" != 1 ]]; then
    [[ -c /dev/kfd ]] || die '/dev/kfd is missing; the host amdgpu/KFD driver is not available'
    [[ -r /dev/kfd && -w /dev/kfd ]] || die '/dev/kfd is not readable and writable by this user; check video/render group membership'

    shopt -s nullglob
    render_nodes=(/dev/dri/renderD*)
    shopt -u nullglob
    [[ ${#render_nodes[@]} -gt 0 ]] || die 'no /dev/dri/renderD* node is available'
    [[ -r "${render_nodes[0]}" && -w "${render_nodes[0]}" ]] || die "${render_nodes[0]} is not readable and writable by this user; check the render group"
fi

podman_args=(
    run
    --rm
    --pull="$(if [[ "${image}" == *@sha256:* ]]; then printf missing; else printf newer; fi)"
    --userns=keep-id
    --user "$(id -u):$(id -g)"
    --group-add=keep-groups
    --cap-drop=all
    --security-opt=no-new-privileges
    --security-opt=seccomp=unconfined
    --security-opt=label=disable
    --volume "${models_dir}:/models:ro"
    --volume "${hf_home}:/cache/huggingface:rw"
    --env HF_HOME=/cache/huggingface
    --env LLAMA_CACHE=/cache/huggingface/hub
    --workdir /models
)

if [[ ${needs_gpu} -eq 1 ]]; then
    podman_args+=(--device=/dev/kfd --device=/dev/dri)
fi

for forwarded_env in HF_TOKEN ROCR_VISIBLE_DEVICES HIP_VISIBLE_DEVICES; do
    if [[ -n "${!forwarded_env:-}" ]]; then
        podman_args+=(--env "${forwarded_env}")
    fi
done

if [[ -t 0 && -t 1 && "${command_name}" != server ]]; then
    podman_args+=(--interactive --tty)
fi

case "${command_name}" in
    server)
        host_port="${LLAMA_ROCM_PORT:-8080}"
        bind_address="${LLAMA_ROCM_BIND_ADDRESS:-127.0.0.1}"
        [[ "${host_port}" =~ ^[0-9]+$ ]] && ((host_port >= 1 && host_port <= 65535)) \
            || die "invalid LLAMA_ROCM_PORT: ${host_port}"
        podman_args+=(--publish "${bind_address}:${host_port}:8080")
        container_command=(/opt/llama/bin/llama-server --host 0.0.0.0 --port 8080 "$@")
        ;;
    cli)
        container_command=(/opt/llama/bin/llama-cli "$@")
        ;;
    bench)
        container_command=(/opt/llama/bin/llama-bench "$@")
        ;;
    rocminfo)
        container_command=(/opt/rocm/bin/rocminfo "$@")
        ;;
    version)
        printf 'llama-rocm %s\nimage: %s\n' "${RELEASE_VERSION}" "${image}"
        container_command=(/opt/llama/bin/llama-cli --version)
        ;;
esac

exec "${PODMAN}" "${podman_args[@]}" "${image}" "${container_command[@]}"
